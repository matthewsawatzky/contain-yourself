{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contain-yourself.dev/schemas/app-store-bundle-v1.json",
  "title": "Contain Yourself app-store bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "summary",
    "description",
    "categories",
    "authors",
    "license",
    "links",
    "compatibility",
    "icon",
    "screenshots",
    "package"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$"},
    "name": {"type": "string", "minLength": 1},
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "summary": {"type": "string", "minLength": 8, "maxLength": 100},
    "description": {"type": "string", "minLength": 20, "maxLength": 2000},
    "categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$"}
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "url": {"type": "string", "format": "uri", "pattern": "^https://"}
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog", "upstream"],
      "properties": {
        "catalog": {"type": "string", "minLength": 1},
        "upstream": {"type": "string", "minLength": 1}
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "required": ["homepage", "source", "support"],
      "properties": {
        "homepage": {"type": "string", "format": "uri", "pattern": "^https://"},
        "source": {"type": "string", "format": "uri", "pattern": "^https://"},
        "support": {"type": "string", "format": "uri", "pattern": "^https://"}
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_controller_version", "platforms"],
      "properties": {
        "minimum_controller_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["linux/amd64", "linux/arm64"]}
        }
      }
    },
    "icon": {"type": "string", "minLength": 1},
    "screenshots": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload_sha256", "payload_size_bytes", "files"],
      "properties": {
        "payload_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "payload_size_bytes": {"type": "integer", "minimum": 1},
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/file"}
        }
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
