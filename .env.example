# Generate with: openssl rand -hex 32
WORKER_TOKEN=change-this-development-token-0123456789abcdef

# Controller binds to loopback by default. Set 0.0.0.0 only for trusted LAN use.
CONTROLLER_BIND=127.0.0.1
DATA_DIRECTORY=./data
CONFIG_DIRECTORY=.
# Set these to `id -u` and `id -g` on Linux when they differ from 1000.
CONTROLLER_UID=1000
CONTROLLER_GID=1000
PUBLIC_BASE_DOMAIN=
SECURE_COOKIES=false
SESSION_LIFETIME=24h
WM_VERSION=v0.4.1
APP_STORE_INDEX_URL=https://raw.githubusercontent.com/matthewsawatzky/contain-yourself/main/app_store/index.json

# Core and legacy images accepted without an app-store approval.
WORKER_ALLOWED_IMAGES=alpine:3.21,tsl0922/ttyd:1.7.7,filebrowser/filebrowser:v2.32.0,codercom/code-server:4.99.4,lscr.io/linuxserver/chromium@sha256:92933242f71646b24d568cab82c8da1eb0838c067a281ad9dce74fe94e7d0fe1
WSLAN_IMAGE=contain-yourself-wslan:dev
WORKER_DATA_SOURCE=./data/worker

# Workspace images seed /workspace once at creation. Must also be allowlisted above.
DEFAULT_WORKSPACE_IMAGE=alpine:3.21

# WireGuard profiles are uploaded after startup and encrypted under DATA_DIRECTORY.
# Leave VPN_ENCRYPTION_KEY unset to have a key file generated automatically, or
# set it to a hex-encoded 32-byte key you manage yourself:
#   docker compose exec controller vpnkeyctl generate
# Changing this on an existing installation requires rotating first:
#   docker compose exec controller vpnkeyctl rotate --new-key <hex>
# VPN_ENCRYPTION_KEY=
